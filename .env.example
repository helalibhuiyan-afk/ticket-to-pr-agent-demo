# Copy to .env (./demo.sh setup does this). Changes take effect on ./demo.sh restart.

# Port the demo is served on.
HTTP_PORT=80

# --- LLM -------------------------------------------------------------------
# Local model via Ollama (default). The model is downloaded on first start.
COMPOSE_PROFILES=local-llm
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=gpt-oss:20b
LLM_API_KEY=ollama
OLLAMA_CONTEXT_LENGTH=16384
# Lighter alternatives: qwen3:8b, qwen2.5-coder:7b

# Hosted OpenAI-compatible endpoint instead (faster for a live demo):
# COMPOSE_PROFILES=
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=<model name>
# LLM_API_KEY=<key>

# A scripted mock LLM always runs alongside the real one. Switch between them in the UI
# (dashboard → "Agent LLM"). This sets which one is selected on a fresh install: real or mock.
DEFAULT_LLM_MODE=real
# Pause per mock step (seconds) so the activity timeline is easy to follow.
MOCK_DELAY_SECONDS=0.8

LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=900

# --- Workflow ----------------------------------------------------------------
MAX_TASK_ATTEMPTS=2
TASK_LEASE_SECONDS=1200
